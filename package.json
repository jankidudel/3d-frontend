{
  "name": "3d-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate:build-info": "node --experimental-strip-types scripts/generate-build-info.mts",
    "generate:seo:development": "node --experimental-strip-types scripts/generate-seo-assets.mts development",
    "generate:seo:production": "node --experimental-strip-types scripts/generate-seo-assets.mts production",
    "prepare-build:development": "npm run generate:build-info && npm run generate:seo:development",
    "prepare-build:production": "npm run generate:build-info && npm run generate:seo:production",
    "build": "npm run prepare-build:production && ng build",
    "build:development": "npm run prepare-build:development && ng build --configuration development",
    "build:deployment-development": "npm run prepare-build:development && ng build --configuration deployment-development",
    "watch": "ng build --watch --configuration development",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "precommit": "npm run format:check && npm run lint && npm test",
    "verify": "npm run format:check && npm run lint && npm run typecheck:scripts && npm test && npm run build",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@types/three": "0.181.0",
    "express": "5.2.1",
    "jspdf": "3.0.3",
    "rxjs": "7.8.2",
    "three": "0.181.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
