{
  "name": "3d-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:guides && ng serve",
    "generate:guides": "node --experimental-strip-types scripts/generate-guides.mts",
    "generate:build-info": "node --experimental-strip-types scripts/generate-build-info.mts",
    "generate:seo:development": "node --experimental-strip-types scripts/generate-seo-assets.mts development",
    "generate:seo:production": "node --experimental-strip-types scripts/generate-seo-assets.mts production",
    "assets:fingerprint": "node --experimental-strip-types scripts/fingerprint-static-assets.mts",
    "prepare-build:development": "npm run generate:guides && npm run generate:build-info && npm run generate:seo:development",
    "prepare-build:production": "npm run generate:guides && npm run generate:build-info && npm run generate:seo:production",
    "build": "npm run generate:guides && npm run build:prepared",
    "build:deployment-development": "npm run prepare-build:development && ng build --configuration deployment-development && npm run assets:fingerprint",
    "build:development": "npm run prepare-build:development && ng build --configuration development",
    "check:internal-links": "node --experimental-strip-types scripts/check-internal-links.mts",
    "seo:check": "npm run verify",
    "watch": "ng build --watch --configuration development",
    "typecheck:scripts": "npm run generate:guides && tsc --project tsconfig.scripts.json && tsc --project tsconfig.collection-examples.json",
    "lint": "npm run generate:guides && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run generate:guides && npm run verify:tests",
    "test:sitemap": "vitest run scripts/sitemap.spec.mts",
    "test:deployment-workflow": "vitest run scripts/deployment-workflow.spec.mts scripts/retire-tool-documents.spec.mts",
    "test:internal-links": "vitest run scripts/check-internal-links.spec.mts",
    "test:tool-layout": "vitest run scripts/tool-layout.spec.mts",
    "test:material-page-styles": "vitest run scripts/material-page-styles.spec.mts",
    "precommit": "npm run lint && npm test",
    "verify": "npm run verify:push && npm run seo:render && npm run seo:artifact:seal",
    "hooks:install": "node --experimental-strip-types scripts/seo-hooks.mts install",
    "test:collection-examples": "vitest run scripts/collection-examples.spec.mts",
    "test:seo-recovery": "vitest run scripts/seo-audit.spec.mts scripts/recovery-evidence.spec.mts scripts/sizing-evidence.spec.mts scripts/export-fidelity.spec.mts scripts/file-handoff.spec.mts",
    "seo:audit": "node --experimental-strip-types scripts/seo-audit.mts",
    "seo:audit:production": "node --experimental-strip-types scripts/verify-production-routes.mts",
    "check:route-coverage": "node --experimental-strip-types scripts/audit-route-coverage.mts",
    "test:route-coverage": "vitest run scripts/route-coverage.spec.mts",
    "seo:verify-production": "node --experimental-strip-types scripts/verify-production-routes.mts",
    "seo:legacy": "node --experimental-strip-types scripts/seo-check.mts",
    "seo:staged": "node --experimental-strip-types scripts/seo-hooks.mts staged",
    "seo:source": "node --experimental-strip-types scripts/seo-check.mts --source-only && node --experimental-strip-types scripts/seo-source.mts",
    "seo:build": "npm run build",
    "seo:html": "node --experimental-strip-types scripts/technical-seo.mts",
    "seo:render": "node --experimental-strip-types scripts/seo-browser.mts",
    "seo:artifact": "node --experimental-strip-types scripts/seo-artifact.mts",
    "seo:artifact:seal": "node --experimental-strip-types scripts/seo-artifact.mts --seal",
    "test:technical-seo": "vitest run scripts/technical-seo.spec.mts scripts/seo-hooks.spec.mts scripts/module-preloads.spec.mts scripts/discovery-audit.spec.mts scripts/seo-live.spec.mts",
    "seo:live": "node --experimental-strip-types scripts/seo-live.mts",
    "seo:performance": "node --experimental-strip-types scripts/seo-performance.mts",
    "seo:js-budget": "node --experimental-strip-types scripts/page-js-budget.mts",
    "screenshots:live": "node --experimental-strip-types scripts/screenshots-live.mts",
    "verify:push": "npm run verify:prepare && npm run verify:source && npm run verify:tests && npm run verify:build",
    "build:prepared": "npm run generate:build-info && npm run generate:seo:production && ng build && npm run assets:fingerprint && npm run seo:legacy && npm run seo:html && npm run seo:js-budget",
    "test:scripts": "vitest run scripts/*.spec.mts",
    "verify:prepare": "npm run generate:guides",
    "verify:source": "npm run format:check && eslint . && tsc --project tsconfig.scripts.json && tsc --project tsconfig.collection-examples.json",
    "verify:tests": "ng test --watch=false && npm run test:scripts",
    "verify:build": "npm run build:prepared && npm run seo:audit"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "22.1.6",
    "@types/three": "0.185.4",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "gray-matter": "4.0.3",
    "jspdf": "4.2.1",
    "meshoptimizer": "1.2.0",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "rxjs": "7.8.2",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.8",
    "tslib": "2.8.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.0",
    "angular-eslint": "22.1.0",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true
  }
}
