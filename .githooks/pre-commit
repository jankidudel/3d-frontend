#!/bin/sh
set -eu

before_format=$(git diff --binary | git hash-object --stdin)
npm run format
after_format=$(git diff --binary | git hash-object --stdin)

if [ "$before_format" != "$after_format" ]; then
  echo "Frontend formatting was applied. Review and stage the changes, then commit again."
  exit 1
fi

echo "Running pre-commit checks..."
if ! git diff --cached --quiet -- src/content/guides src/app/features/guides; then
  npm run generate:guides
  npm run seo:check -- --source-only
fi
npm run precommit
